<Window x:Class="DiskTree.ExcludeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ausschlüsse" Width="480" Height="420" MinWidth="400" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10">
            Diese Ordner überspringt der Scan samt Inhalt. Ihre Größe fehlt dann in den Summen
            und taucht unter „Nicht erfasst“ auf.
        </TextBlock>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Height="30" VerticalContentAlignment="Center" KeyDown="Input_KeyDown"
                     ToolTip="Ordnername, Name mit * und ?, oder kompletter Pfad" />
            <Button Grid.Column="1" Content="Hinzufügen" Height="30" Padding="14,0" Margin="8,0,0,0" Click="Add_Click" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}"
                         SelectionMode="Extended" KeyDown="List_KeyDown" Padding="2" />
                <TextBlock x:Name="EmptyHint" Text="Keine Ausschlüsse." Foreground="{DynamicResource Subtle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Entfernen" Height="30" Padding="14,0" Click="Remove_Click" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource Subtle}"
                       FontSize="11" TextTrimming="CharacterEllipsis"
                       Text="z. B. node_modules · *.tmp · C:\Windows\Temp" />
            <Button Grid.Column="2" Content="OK" Width="80" Height="30" IsDefault="True" Click="Ok_Click" />
            <Button Grid.Column="3" Content="Abbrechen" Width="90" Height="30" Margin="8,0,0,0" IsCancel="True" />
        </Grid>
    </Grid>
</Window>

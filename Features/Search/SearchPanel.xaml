<UserControl x:Class="DiskTree.Features.Search.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiskTree.Features.Search">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0,4,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" Height="28" VerticalContentAlignment="Center" KeyDown="Box_KeyDown"
                     ToolTip="Teil des Namens (Groß-/Kleinschreibung egal). Enter startet die Suche." />
            <Button x:Name="GoButton" Grid.Column="1" Content="Suchen" Height="28" MinWidth="76" Margin="6,0,0,0" Click="Go_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,4,6">
            <TextBlock Text="Suche nach" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="ModeBox" Width="112" Height="26" SelectedIndex="0" SelectionChanged="Mode_Changed">
                <ComboBoxItem Content="Ordnern" />
                <ComboBoxItem Content="Dateien" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,0,4,6">
            <TextBlock Text="Größe ≥" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="SizeBox" Width="60" Height="26" VerticalContentAlignment="Center" KeyDown="Box_KeyDown"
                     ToolTip="Mindestgröße, leer = egal" />
            <ComboBox x:Name="UnitBox" Width="78" Height="26" Margin="6,0,0,0" SelectedIndex="0">
                <ComboBoxItem Content="MB" />
                <ComboBoxItem Content="GB" />
            </ComboBox>
            <TextBlock x:Name="ExtLabel" Text="Endung" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox x:Name="ExtBox" Width="80" Height="26" VerticalContentAlignment="Center" KeyDown="Box_KeyDown"
                     ToolTip="Nur bei Dateien: z. B. mp4, .zip (mehrere mit Komma)" />
        </StackPanel>

        <!-- Date and attribute conditions (files only); folded away by default. Code: SearchPanel.Filters.cs -->
        <Expander x:Name="MoreFilters" Grid.Row="3" Margin="4,0,4,6" Header="Weitere Filter" Foreground="{DynamicResource Ink}">
            <StackPanel Margin="4,6,0,2" ToolTip="Gelten nur bei der Suche nach Dateien">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Datum" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Width="76" />
                    <ComboBox x:Name="StampBox" Width="150" Height="26" SelectedIndex="0" SelectionChanged="Stamp_Changed"
                              ToolTip="Welcher Zeitstempel der Datei geprüft wird">
                        <ComboBoxItem Content="(egal)" />
                        <ComboBoxItem Content="Zuletzt geändert" />
                        <ComboBoxItem Content="Zuletzt geöffnet" />
                        <ComboBoxItem Content="Erstellt" />
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="AgeRow" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="False">
                    <TextBlock Text="vor mehr als" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Width="76" />
                    <TextBox x:Name="AmountBox" Width="52" Height="26" VerticalContentAlignment="Center" Text="3" KeyDown="Box_KeyDown"
                             ToolTip="Anzahl, z. B. 3" />
                    <ComboBox x:Name="UnitAgeBox" Width="90" Height="26" Margin="6,0,0,0" SelectedIndex="2">
                        <ComboBoxItem Content="Tagen" />
                        <ComboBoxItem Content="Monaten" />
                        <ComboBoxItem Content="Jahren" />
                    </ComboBox>
                </StackPanel>
                <Border x:Name="AccessWarning" Visibility="Collapsed" Margin="0,0,0,6" Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource TrackBg}" BorderBrush="#E8B923" BorderThickness="3,0,0,0">
                    <TextBlock x:Name="AccessWarningText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Ink}" />
                </Border>
                <TextBlock Text="Attribute (alle gewählten müssen zutreffen)" Foreground="{DynamicResource Muted}" Margin="0,0,0,4" />
                <WrapPanel x:Name="AttrPanel">
                    <CheckBox Content="Versteckt" Tag="0" Margin="0,0,14,4" Checked="Attr_Changed" Unchecked="Attr_Changed" />
                    <CheckBox Content="System" Tag="1" Margin="0,0,14,4" Checked="Attr_Changed" Unchecked="Attr_Changed" />
                    <CheckBox Content="Schreibgeschützt" Tag="2" Margin="0,0,14,4" Checked="Attr_Changed" Unchecked="Attr_Changed" />
                    <CheckBox Content="Komprimiert" Tag="3" Margin="0,0,14,4" Checked="Attr_Changed" Unchecked="Attr_Changed" />
                    <CheckBox Content="Verschlüsselt" Tag="4" Margin="0,0,14,4" Checked="Attr_Changed" Unchecked="Attr_Changed" />
                    <CheckBox Content="Offline / Cloud" Tag="5" Margin="0,0,14,4" Checked="Attr_Changed" Unchecked="Attr_Changed" />
                </WrapPanel>
            </StackPanel>
        </Expander>

        <Grid Grid.Row="4" Margin="4,0,4,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ScopeText" Foreground="{DynamicResource Subtle}" FontSize="11" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <ProgressBar x:Name="Busy" Grid.Column="1" Width="70" Height="5" IsIndeterminate="True" Visibility="Collapsed"
                         Margin="8,0,0,0" Background="{DynamicResource TrackBg}" BorderThickness="0" />
        </Grid>

        <ListBox x:Name="Results" Grid.Row="5" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseRightButtonDown="Results_RightDown" MouseRightButtonUp="Results_RightUp"
                 MouseDoubleClick="Results_DoubleClick" PreviewKeyDown="Results_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:SearchHitRow}">
                    <Grid Margin="0,3" ToolTip="{Binding ToolTipText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DetailText}" Visibility="{Binding DetailVisibility}" FontSize="11"
                                       Foreground="{DynamicResource Subtle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusText" Grid.Row="6" Margin="4,6,4,0" Foreground="{DynamicResource Muted}" FontSize="11"
                   TextWrapping="Wrap" Text="Strg+F: Suche öffnen. Doppelklick springt zum Eintrag im Baum." />
    </Grid>
</UserControl>

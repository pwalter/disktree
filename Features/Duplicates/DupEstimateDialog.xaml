<Window x:Class="DiskTree.Features.Duplicates.DupEstimateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplikate suchen – Schätzung" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock x:Name="Summary" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
        <TextBlock x:Name="Where" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />

        <Border Margin="0,12,0,0" Padding="10,8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="Listed" TextWrapping="Wrap" LineHeight="20" />
        </Border>

        <TextBlock Text="Modus" FontWeight="SemiBold" Margin="0,14,0,4" />
        <RadioButton x:Name="FastRadio" GroupName="Mode" IsChecked="True" Checked="Input_Changed" AutomationProperties.Name="Schnell">
            <TextBlock><Run Text="Schnell" FontWeight="SemiBold" /><Run x:Name="FastShort" /></TextBlock>
        </RadioButton>
        <TextBlock x:Name="FastText" Margin="22,2,0,8" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
        <RadioButton x:Name="ThoroughRadio" GroupName="Mode" Checked="Input_Changed" AutomationProperties.Name="Gründlich">
            <TextBlock><Run Text="Gründlich" FontWeight="SemiBold" /><Run x:Name="ThoroughShort" /></TextBlock>
        </RadioButton>
        <TextBlock x:Name="ThoroughText" Margin="22,2,0,0" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Download-Limit pro Lauf" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="LimitBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" TextChanged="Input_Changed"
                     AutomationProperties.Name="Download-Limit in GB"
                     ToolTip="Wird es erreicht, fragt die Suche, ob sie weiter herunterladen soll. 0 = ohne Limit." />
            <TextBlock Grid.Column="2" Text="GB" VerticalAlignment="Center" Margin="6,0,0,0" />
        </Grid>
        <TextBlock x:Name="Warning" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#D08A00" Visibility="Collapsed" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0" />
            <Button x:Name="OkButton" Grid.Column="1" Content="Vergleichen" MinWidth="110" Height="30" Padding="14,0" IsDefault="True" Click="Ok_Click" />
            <Button x:Name="CancelButton" Grid.Column="2" Content="Abbrechen" Width="90" Height="30" Margin="8,0,0,0" IsCancel="True" />
        </Grid>
    </StackPanel>
</Window>

<Window x:Class="DiskTree.Ui.TargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verschieben" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Summary" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />

        <Border Grid.Row="1" Margin="0,8,0,12" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1" CornerRadius="6" MaxHeight="110">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Names" Margin="8,6" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="TargetLabel" Grid.Row="2" Text="Zielordner" Margin="0,0,0,4" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox" Height="30" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Durchsuchen …" Height="30" Padding="12,0" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel x:Name="MovePanel">
                <TextBlock Text="Gibt es den Namen im Ziel schon" Margin="0,0,0,4" />
                <ComboBox x:Name="PolicyBox" Height="30" />
            </StackPanel>
            <CheckBox x:Name="RecycleBox" Visibility="Collapsed"
                      Content="Originale nach dem Archivieren in den Papierkorb legen" />
            <TextBlock x:Name="Hint" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource Subtle}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Verschieben" MinWidth="100" Height="30" Padding="14,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Abbrechen" Width="90" Height="30" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

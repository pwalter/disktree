<Window x:Class="DiskTree.Ui.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name schon vorhanden" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock x:Name="Message" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock x:Name="Detail" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource Muted}" />
        <CheckBox x:Name="AllBox" Content="Für alle weiteren Konflikte übernehmen" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Überspringen" Height="30" Padding="12,0" Click="Skip_Click" IsCancel="True" />
            <Button Content="Ersetzen" Height="30" Padding="12,0" Margin="8,0,0,0" Click="Replace_Click" />
            <Button Content="Umbenennen" Height="30" Padding="12,0" Margin="8,0,0,0" Click="Rename_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>

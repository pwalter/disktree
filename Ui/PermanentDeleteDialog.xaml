<Window x:Class="DiskTree.Ui.PermanentDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Endgültig löschen" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#D6453D" CornerRadius="6" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="22" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="Headline" Foreground="White" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                           VerticalAlignment="Center" MaxWidth="460" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1" CornerRadius="6" MaxHeight="340">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="Details" Margin="6,4" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource Ink}" TextWrapping="Wrap" AutomationProperties.Name="Was gelöscht wird" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="Warning" Grid.Row="2" Margin="0,10,0,0" Foreground="#D6453D" FontWeight="SemiBold" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DeleteButton" Content="Endgültig löschen" MinWidth="140" Height="30" Padding="14,0" Click="Delete_Click"
                    Background="#D6453D" Foreground="White" BorderBrush="#B8372F"
                    ToolTip="Löscht die Auswahl auf dem Server. Das kann nicht rückgängig gemacht werden." />
            <!-- The default button (Enter) and Esc: cancel. Nothing is deleted without clicking the red button. -->
            <Button x:Name="CancelButton" Content="Abbrechen" MinWidth="100" Height="30" Margin="8,0,0,0" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

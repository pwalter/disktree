<UserControl x:Class="DiskTree.ComparePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiskTree">
    <UserControl.Resources>
        <DataTemplate x:Key="DiffRowTemplate" DataType="{x:Type local:DiffItem}">
            <Grid Margin="0,3" ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DeltaText}" Foreground="{Binding Brush}" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,6">
            <Button x:Name="CurrentButton" Content="Gespeicherten Scan mit aktuellem vergleichen …" Padding="10,5"
                    HorizontalContentAlignment="Left" Click="Current_Click"
                    ToolTip="Wählt eine .disktree-Datei (alter Stand) und vergleicht sie mit dem Scan, der gerade im Baum steht" />
            <Button x:Name="TwoButton" Content="Zwei gespeicherte Scans vergleichen …" Padding="10,5" Margin="0,4,0,0"
                    HorizontalContentAlignment="Left" Click="Two_Click"
                    ToolTip="Wählt erst den älteren, dann den neueren Scan" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="4,0,4,6">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                       Text="Noch kein Vergleich. Der ältere Scan ist die Basis: Ordner, die darin kleiner waren, gelten als gewachsen." />
        </StackPanel>

        <Grid Grid.Row="2" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Zeigen" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="FilterBox" Grid.Column="1" SelectionChanged="Filter_Changed" IsEnabled="False">
                <ComboBoxItem Content="Alle Änderungen" IsSelected="True" />
                <ComboBoxItem Content="Gewachsen" />
                <ComboBoxItem Content="Geschrumpft" />
                <ComboBoxItem Content="Neu" />
                <ComboBoxItem Content="Entfernt" />
            </ComboBox>
        </Grid>

        <ListBox x:Name="List" Grid.Row="3" BorderThickness="0" Background="Transparent"
                 ItemTemplate="{StaticResource DiffRowTemplate}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="List_DoubleClick" PreviewKeyDown="List_KeyDown"
                 ToolTip="Doppelklick springt zum Ordner im Baum" />
    </Grid>
</UserControl>

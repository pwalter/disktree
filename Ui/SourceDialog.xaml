<Window x:Class="DiskTree.Ui.SourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quelle" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="170" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

        <DockPanel Style="{StaticResource FieldRow}">
            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" Height="30" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel Style="{StaticResource FieldRow}">
            <TextBlock Text="Typ" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="KindBox" Height="30" SelectionChanged="Kind_Changed" />
        </DockPanel>
        <DockPanel x:Name="RowEndpoint" Style="{StaticResource FieldRow}">
            <TextBlock x:Name="LabelEndpoint" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="EndpointBox" Height="30" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel x:Name="RowPort" Style="{StaticResource FieldRow}">
            <TextBlock x:Name="LabelPort" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="PortBox" Height="30" Width="90" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel x:Name="RowRegion" Style="{StaticResource FieldRow}">
            <TextBlock x:Name="LabelRegion" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="RegionBox" Height="30" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel x:Name="RowPathStyle" Style="{StaticResource FieldRow}">
            <TextBlock Style="{StaticResource FieldLabel}" />
            <CheckBox x:Name="PathStyleBox" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Style="{StaticResource FieldRow}">
            <TextBlock Text="Anmeldung" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="AuthBox" Height="30" SelectionChanged="Auth_Changed" />
        </DockPanel>
        <DockPanel x:Name="RowAwsProfile" Style="{StaticResource FieldRow}">
            <TextBlock x:Name="LabelAwsProfile" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="AwsProfileBox" Height="30" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel x:Name="RowUserName" Style="{StaticResource FieldRow}">
            <TextBlock x:Name="LabelUserName" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UserNameBox" Height="30" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel x:Name="RowSecret" Style="{StaticResource FieldRow}">
            <TextBlock x:Name="LabelSecret" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="SecretBox" Height="30" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel x:Name="RowKeyFile" Style="{StaticResource FieldRow}">
            <TextBlock x:Name="LabelKeyFile" Style="{StaticResource FieldLabel}" />
            <Button DockPanel.Dock="Right" Content="…" Width="34" Height="30" Margin="6,0,0,0" Click="BrowseKey_Click" />
            <TextBox x:Name="KeyFileBox" Height="30" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel x:Name="RowPassphrase" Style="{StaticResource FieldRow}">
            <TextBlock x:Name="LabelPassphrase" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PassphraseBox" Height="30" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel x:Name="RowPath" Style="{StaticResource FieldRow}">
            <TextBlock x:Name="LabelPath" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="PathBox" Height="30" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel x:Name="RowListing" Style="{StaticResource FieldRow}">
            <TextBlock x:Name="LabelListing" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ListingBox" Height="30">
                <ComboBoxItem Content="Ordnerweise (Live-Baum, eine Anfrage je Ordner)" />
                <ComboBoxItem Content="Flach (wenige Anfragen, Baum erscheint am Ende)" />
            </ComboBox>
        </DockPanel>

        <Border Margin="0,4,0,0" Padding="8,6" CornerRadius="4" Background="{DynamicResource TrackBg}"
                BorderBrush="#4C8DF6" BorderThickness="3,0,0,0">
            <TextBlock x:Name="SecretHint" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Ink}" />
        </Border>

        <DockPanel Margin="0,12,0,0">
            <Button x:Name="TestButton" Content="Verbindung testen" Height="30" Padding="14,0" Click="Test_Click" />
            <TextBlock x:Name="TestResult" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Speichern" MinWidth="100" Height="30" Padding="14,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Abbrechen" Width="90" Height="30" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

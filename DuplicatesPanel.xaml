<UserControl x:Class="DiskTree.DuplicatesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiskTree">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TargetText" Text="Duplikate" FontWeight="SemiBold" FontSize="14"
                   TextTrimming="CharacterEllipsis" Margin="4,0" />

        <Grid Grid.Row="1" Margin="4,8,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RunButton" Content="Duplikate suchen" Height="28" Padding="12,0" Click="Run_Click"
                    Style="{DynamicResource ToolButton}"
                    ToolTip="Sucht doppelte Dateien im markierten Ordner (inkl. Unterordner)" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="ab" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="MinBox" Width="100" Height="26" DisplayMemberPath="Text"
                          ToolTip="Kleinere Dateien werden ignoriert" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="4,8,4,6">
            <ProgressBar x:Name="Bar" Height="5" Minimum="0" Maximum="1" Visibility="Collapsed"
                         Foreground="{DynamicResource Accent}" Background="{DynamicResource TrackBg}" BorderThickness="0" />
            <TextBlock x:Name="InfoText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"
                       Text="Ordner links markieren und auf „Duplikate suchen“ klicken." />
        </StackPanel>

        <TreeView x:Name="List" Grid.Row="3" BorderThickness="0" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  PreviewMouseRightButtonDown="List_RightDown" MouseRightButtonUp="List_RightUp"
                  MouseDoubleClick="List_DoubleClick" PreviewKeyDown="List_KeyDown">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type local:DupGroupVM}" ItemsSource="{Binding Files}">
                    <Grid Margin="0,3" ToolTip="{Binding Detail}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding WastedText}" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                    </Grid>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type local:DupFileVM}">
                    <StackPanel Margin="0,2" ToolTip="{Binding Path}">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
